APP_NAME="Node PSP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# PSP
# ---------------------------------------------------------------------------
PSP_NAME="Node PSP"
PSP_DEFAULT_CURRENCY=GHS
PSP_DEFAULT_PROVIDER=mtn_momo
PSP_FEE_BPS=150
PSP_WEBHOOK_TIMEOUT=10
PSP_WEBHOOK_MAX_ATTEMPTS=6

# MTN MoMo (sandbox: https://sandbox.momodeveloper.mtn.com)
# 1. Sign up at https://momodeveloper.mtn.com, subscribe to Collection + Disbursement,
#    copy the Primary Key of each into the *_SUBSCRIPTION_KEY vars below.
# 2. Run `php artisan momo:provision-sandbox` to mint the API user + key for each product.
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_ENVIRONMENT=sandbox
MTN_MOMO_CURRENCY=EUR
MTN_MOMO_CALLBACK_HOST=example.com
MTN_MOMO_CALLBACK_URL=

MTN_MOMO_COLLECTION_SUBSCRIPTION_KEY=
MTN_MOMO_COLLECTION_API_USER=
MTN_MOMO_COLLECTION_API_KEY=

MTN_MOMO_DISBURSEMENT_SUBSCRIPTION_KEY=
MTN_MOMO_DISBURSEMENT_API_USER=
MTN_MOMO_DISBURSEMENT_API_KEY=

# Crypto deposits (stablecoin on-ramp)
# A chain watcher (node/indexer) confirms on-chain payments and calls
# /webhooks/crypto/{reference}, signing with PSP_CRYPTO_WATCHER_SECRET.
PSP_CRYPTO_PROVIDER=watcher
PSP_CRYPTO_DEPOSIT_TTL=60
PSP_CRYPTO_WATCHER_SECRET=
CRYPTO_USDT_TRON_ADDRESS=
CRYPTO_USDT_TRON_CONFIRMATIONS=20
CRYPTO_USDT_ETH_ADDRESS=
CRYPTO_USDT_ETH_CONFIRMATIONS=12
CRYPTO_USDC_BASE_ADDRESS=
CRYPTO_USDC_BASE_CONFIRMATIONS=12
